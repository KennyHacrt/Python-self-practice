def twoSum(self, nums, target):
        sum=0
        a=len(nums)
        small=0
        big=0
        ls=[]
        key=0
        for i in range(a):
            for j in range(a):
                if i==j:
                    continue
                if nums[i]+nums[j]==target:
                    small=i
                    big=j
                    key=1
                    break
            if key==1:
                break
        if small>big:
            ls.append(big)
            ls.append(small)
        else:
            ls.append(small)
            ls.append(big)
        return ls
